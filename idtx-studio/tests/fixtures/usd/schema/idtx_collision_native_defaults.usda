#usda 1.0
(
    defaultPrim = "World"
    doc = """Fixture for StudioSession::apply_collision_api native-geometry
    default seeding. Each analytic gprim carries non-default dimensions (and a
    non-Y axis for the cylinder/capsule) so the test can prove the collider's
    idtx:collision:<shape>:* defaults are copied from the prim's own geometry —
    including the Z/X axis the bounds-derived fallback could never produce.
    Starts WITHOUT IdtxCollisionAPI; the test applies it."""
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Sphere "Ball"
    {
        double radius = 3
    }

    def Cube "Crate"
    {
        double size = 4
    }

    def Cylinder "Pillar"
    {
        uniform token axis = "Z"
        double height = 5
        double radius = 2
    }

    def Capsule "Pill"
    {
        uniform token axis = "X"
        double height = 2
        double radius = 0.5
    }
}
