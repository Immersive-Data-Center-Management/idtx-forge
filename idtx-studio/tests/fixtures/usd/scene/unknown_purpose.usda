#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
    doc = "Fixture for unknown_purpose_is_a_visible_diagnostic_not_a_projection_failure. /World/Known is an imageable prim with a known purpose ('render'), /World/Other is an imageable with an unknown purpose token 'other'. The 'Other' prim must appear in the visibility records with RenderPurpose::Default and produce a diagnostic containing 'unknown imageable purpose other'."
)

def Xform "World"
{
    def Xform "Known" (
        prepend apiSchemas = ["GeomModelAPI"]
    )
    {
        uniform token purpose = "render"
        def Sphere "Ball"
        {
            double radius = 1
        }
    }

    def Xform "Other"
    {
        uniform token purpose = "other"
        def Sphere "Ball"
        {
            double radius = 1
        }
    }
}
