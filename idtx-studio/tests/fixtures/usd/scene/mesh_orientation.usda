#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
    doc = "Fixture for mesh_orientation_is_preserved_in_the_typed_projection. Two meshes: /World/RightHanded (default, orientation='rightHanded') and /World/LeftHanded (orientation='leftHanded'). Exactly one must have left_handed=true in the typed projection."
)

def Xform "World"
{
    def Mesh "RightHanded"
    {
        uniform token orientation = "rightHanded"
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }

    def Mesh "LeftHanded"
    {
        uniform token orientation = "leftHanded"
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }
}
