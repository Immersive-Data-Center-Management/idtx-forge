#usda 1.0
(
    doc = """Regression fixture for in-place loose Save.

A loose scene whose material references textures that cannot resolve on this
machine: a UDIM placeholder with no tiles on disk, and a foreign-OS absolute
path. These pre-existing unresolved dependencies must NOT block an in-place
loose Save — the save rewrites only the authored root layer and never relocates
external assets. Mirrors the MarketScene/FullScene failure where the save path
aborted with "source stage has unresolved dependencies and cannot be verified
for save". See the LooseSave persistence-verification mode in usd_shim.cpp."""
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Ground" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = true
        float3[] extent = [(-1, 0, -1), (1, 0, 1)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </World/Materials/Clay>
        point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
    }

    def Scope "Materials"
    {
        def Material "Clay"
        {
            token outputs:surface.connect = </World/Materials/Clay/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Materials/Clay/BaseColor.outputs:rgb>
                float3 inputs:normal.connect = </World/Materials/Clay/Normal.outputs:rgb>
                token outputs:surface
            }

            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/missing_<UDIM>_basecolor.png@
                float3 outputs:rgb
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @/nonexistent/foreign/machine/TentFabricColor.jpg@
                float3 outputs:rgb
            }
        }
    }
}
