#usda 1.0
(
    defaultPrim = "Panel"
    doc = """Hand-authored widget stage reproducing the "Asset Overview" asset
    card mockup (GPS-03 GeneralPurposeServer), now using the restructured widget
    schema: every element derives from the abstract `IdtxWidgetElement`
    (UsdGeomImageable) and is placed by `idtx:widget:position` (NORMALIZED,
    (0,0) = top-left … (1,1) = bottom-right). This replaces the earlier
    single-column monospace-label workaround with the real two-column form each
    row is a caption `IdtxWidgetLabel` (left) + a value `IdtxWidgetFieldString`
    (right) at the same normalized Y. The field values are authored as literals
    here but, being `IdtxWidgetField*` value leaves, each `idtx:widget:value`
    can be connected to an openExec compute output / data provider.

    Residual rasterizer limits (first positioning iteration): `idtx:widget:fontSize`
    is still not honoured (glyph scale derives from the per-row height, uniform
    across rows — the title / section headers read larger only via a brighter
    `idtx:widget:color`); the `°` glyph is absent from the embedded font8x8 so the
    temperature is authored "46 C"; section rules are rows of '-'; rounded corners
    are not supported. Long values (e.g. the model strings) auto-shrink to fit the
    width to the right of their position.

    Requires idtx_usd_extension::install(). NOT part of the automated test-suite
    (tests/fixtures/usd/widgets)."""
    upAxis = "Y"
    metersPerUnit = 1
    customLayerData = {
        dictionary idtx = {
            string displayName = "Asset Overview"
            string schemaVersion = "1"
            token stageKind = "widget"
        }
    }
)

def IdtxWidgetPanel "Panel" (
    doc = "Asset-overview card. Portrait (~0.6 aspect). Rows placed by normalized position: caption label (x=0.06) | value field (x=0.52)."
)
{
    float2 idtx:widget:size = (0.68, 1.14)
    int2 idtx:widget:resolution = (680, 1140)
    uniform token idtx:widget:billboard = "none"
    uniform token idtx:widget:space = "world"
    uniform bool idtx:widget:doubleSided = true
    float idtx:widget:opacity = 1

    # ── Header ─────────────────────────────────────────────────────────────
    def IdtxWidgetLabel "Title" {
        string idtx:widget:text = "Asset Overview"
        color3f idtx:widget:color = (0.95, 0.96, 1)
        float2 idtx:widget:position = (0.06, 0.03)
        float idtx:widget:fontSize = 60
        token idtx:widget:fontFamily = "Roboto"
    }
    def IdtxWidgetFieldString "AssetIdVal" {
        string idtx:widget:value = "Some Asset ID"
        color3f idtx:widget:color = (0.9, 0.92, 0.98)
        float2 idtx:widget:position = (0.06, 0.08)
        float idtx:widget:fontSize = 50
    }
    def IdtxWidgetFieldString "AssetKindVal" {
        string idtx:widget:value = "Server"
        color3f idtx:widget:color = (0.5, 0.52, 0.58)
        float2 idtx:widget:position = (0.06, 0.12)
        float idtx:widget:fontSize = 50
    }
    def IdtxWidgetLabel "Rule0" {
        string idtx:widget:text = "------------------------------"
        color3f idtx:widget:color = (0.28, 0.3, 0.36)
        float2 idtx:widget:position = (0.04, 0.16)
    }

