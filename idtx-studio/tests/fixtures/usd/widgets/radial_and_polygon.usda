#usda 1.0
(defaultPrim = "World")
def Xform "World" {
    double3 xformOp:translate = (2, 1, -3)
    float xformOp:rotateY = 30
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
    def IdtxWidgetPanel "Three" (prepend references = @../../../../examples/widgets/radial_menu.usda@) {
        double3 xformOp:translate = (-0.4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def IdtxWidgetPanel "Five" (prepend references = @../../../../examples/widgets/five_actions.usda@) {
        double3 xformOp:translate = (0.4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform token idtx:widget:billboard = "screenAligned"
    }
    def IdtxWidgetPanel "Message" (prepend references = @../../../../examples/widgets/polygon_message.usda@) {
        double3 xformOp:translate = (0, -0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def IdtxWidgetContainer "Hidden" {
            token visibility = "invisible"
            def IdtxWidgetButton "Never" {
                string idtx:widget:label = "Hidden"
            }
        }
    }
}
