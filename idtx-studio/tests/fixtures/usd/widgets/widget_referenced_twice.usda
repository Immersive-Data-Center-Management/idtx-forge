#usda 1.0
(
    defaultPrim = "World"
    doc = "Phase-2/3 widget fixture: the SAME widget stage (widget_panel_stage.usda, whose defaultPrim is an IdtxWidgetPanel) referenced TWICE into one 3D scene — demonstrating a reusable 'library widget'. FacePanel references it with a FIXED orientation (billboard=none) mounted on the +Z face of a cube. TipPanel references the same stage at the apex of a cone with billboard=screenAligned, so it follows the camera. Both instances share the referenced element tree (Container → Label 'Title' + Button 'Ok'); only the per-reference transform/size/billboard overrides differ. Requires idtx_usd_extension::install()."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Floor"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, 0, -4), (4, 0, -4), (4, 0, 4), (-4, 0, 4)]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.55)]
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, -1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "Block"
    {
        color3f[] primvars:displayColor = [(0.75, 0.4, 0.35)]
        double size = 1.2
        double3 xformOp:translate = (-1.2, 0.6, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "Spire"
    {
        uniform token axis = "Y"
        double height = 1.6
        color3f[] primvars:displayColor = [(0.35, 0.55, 0.75)]
        double radius = 0.5
        double3 xformOp:translate = (1.2, 0.8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "FacePanel" (
        prepend references = @./widget_panel_stage.usda@
    )
    {
        uniform token idtx:widget:billboard = "none"
        float2 idtx:widget:size = (0.9, 0.7)
        float3 xformOp:scale = (1.341, 1.722, 1)
        double3 xformOp:translate = (-1.2, 0.6, 0.62)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "TipPanel" (
        prepend references = @./widget_panel_stage.usda@
    )
    {
        uniform token idtx:widget:billboard = "screenAligned"
        float2 idtx:widget:size = (0.7, 0.5)
        float3 xformOp:scale = (1.15, 1, 1)
        double3 xformOp:translate = (1.2, 1.95, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

