#usda 1.0
(
    defaultPrim = "World"
    doc = "Behavior-driven widget fixture (companion to widget_bound_value.usda, which drives the value via an openExec compute binding). Here NO compute graph is present: the `widget_fetch_value` behavior attached to the IdtxWidgetPanel issues an HTTP GET, extracts a scalar from the response with an aas_json-style path, and authors it into the IdtxWidgetFieldString child's `idtx:widget:value` in the session layer — which re-hydrates + re-rasterizes the panel live. The panel floats above the floor with a FIXED world orientation (billboard = none) and renders `Latest  <value>` in dark green. Requires idtx_usd_extension::install(); the behavior needs its host `net` endpoint on the runtime [network] allowlist. Exercised by idtx-studio-session authoring tests (apply seam) and, end-to-end, by idtx-runtime against a stub endpoint."
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    # Framing camera, in front of the panel's +Z face looking toward -Z.
    def Camera "ViewCam"
    {
        float focalLength = 24
        float horizontalAperture = 20.955
        float verticalAperture = 15.2908
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0.1, 0.95, 5.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Ground plane for context / grounding.
    def Mesh "Floor"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, 0, -4), (4, 0, -4), (4, 0, 4), (-4, 0, 4)]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.55)]
    }

    # World-fixed readout panel floating above the floor. The `widget_fetch_value`
    # behavior is attached here (scope defaults to `entity`, so the behavior's
    # self entity is this panel); its FIELD_NAME = "Row/Value" addresses the
    # IdtxWidgetFieldString child below, relative to this panel.
    def IdtxWidgetPanel "Readout" (
        prepend apiSchemas = ["IdtxBehaviorAPI"]
        doc = "World-fixed readout panel whose field value is driven by the widget_fetch_value behavior (HTTP → aas_json → session-layer author)."
    )
    {
        float2 idtx:widget:size = (1.8, 0.4)
        int2 idtx:widget:resolution = (1024, 228)
        uniform token idtx:widget:billboard = "none"
        uniform token idtx:widget:space = "world"
        float idtx:widget:opacity = 1
        double3 xformOp:translate = (1.3, 1.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # Behavior attachment. `source` is the authored .rs; `module` (the
        # compiled .wasm) is filled in by the cross-compile step and gates
        # ticking. Capabilities: `net` (HTTP) + `stage_edit` (author the value).
        token idtx:behavior:kind = "runtime"
        string idtx:behavior:name = "widget_fetch_value"
        string idtx:behavior:version = "0.1.0"
        string idtx:behavior:uuid = "idtx-wfv0-0000-4000-8000-000000000001"
        asset idtx:behavior:source = @./behaviors/widget_fetch_value.rs@
        uniform token[] idtx:behavior:capabilities = ["net", "stage_edit"]

        def IdtxWidgetContainer "Row"
        {
            uniform token idtx:widget:layout = "row"

            def IdtxWidgetLabel "Caption"
            {
                string idtx:widget:text = "Latest"
                float idtx:widget:fontSize = 30
                # Dark green text.
                color3f idtx:widget:color = (0, 0.35, 0.05)
            }

            # String field authored verbatim by the behavior — no compute binding.
            def IdtxWidgetFieldString "Value"
            {
                float idtx:widget:fontSize = 30
                # Dark green text.
                color3f idtx:widget:color = (0, 0.35, 0.05)
                string idtx:widget:value = ""
            }
        }
    }
}
