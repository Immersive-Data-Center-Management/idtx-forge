#usda 1.0
(
    defaultPrim = "World"
    doc = "Demo stage for the `pinch_select_widget` behavior. Look at the Crate and pinch (hand tracking) — or left-click (desktop) — to toggle its child IdtxWidgetPanel 'InfoCard'. The card is authored `visibility = \"invisible\"` so the FIRST select reveals it (pop-up-card UX); release the pinch and pinch again to hide it. The behavior is attached to the `Pawn` (an entity-scoped behavior driven by on_update, NOT to the panel) because it gaze-picks across the scene. Requires idtx_usd_extension::install() for the IdtxWidget* + IdtxBehaviorAPI schemas, and an input_map.toml binding `select` to `Gesture/pinch/{left,right}` (+ Mouse/Left desktop fallback) — see templates/projects/baseline/input_map.toml."
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    # Framing camera, in front of the crate looking toward -Z. `ctx.camera()`
    # reports this (HMD-forward in XR) as the gaze ray.
    def Camera "ViewCam"
    {
        float focalLength = 24
        float horizontalAperture = 20.955
        float verticalAperture = 15.2908
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 1, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Ground plane for context.
    def Mesh "Floor"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, 0, -4), (4, 0, -4), (4, 0, 4), (-4, 0, 4)]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.55)]
    }

    # The gaze target. The behavior rolls the hit gprim up to its whole-asset
    # body, then finds the IdtxWidgetPanel that descends from it.
    def Xform "Crate"
    {
        double3 xformOp:translate = (0, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Body"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.7, 0.45, 0.2)]
        }

        # The panel toggled by select. Authored HIDDEN to match the behavior's
        # assumed baseline (PANEL_STARTS_VISIBLE = false) so the first pinch
        # reveals it. It is a child of the gazed Crate — exactly what the
        # behavior searches for.
        def IdtxWidgetPanel "InfoCard" (
            doc = "World-fixed info card hung off the crate, hidden until the first gaze-pinch select."
        )
        {
            float2 idtx:widget:size = (1.4, 0.5)
            int2 idtx:widget:resolution = (896, 320)
            uniform token idtx:widget:billboard = "none"
            uniform token idtx:widget:space = "world"
            float idtx:widget:opacity = 1
            token visibility = "invisible"
            double3 xformOp:translate = (0, 1.1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def IdtxWidgetContainer "Col"
            {
                uniform token idtx:widget:layout = "column"

                def IdtxWidgetLabel "Title"
                {
                    string idtx:widget:text = "Crate"
                    float idtx:widget:fontSize = 40
                    color3f idtx:widget:color = (0.05, 0.1, 0.05)
                }

                def IdtxWidgetLabel "Hint"
                {
                    string idtx:widget:text = "pinch to toggle"
                    float idtx:widget:fontSize = 28
                    color3f idtx:widget:color = (0.2, 0.3, 0.2)
                }
            }
        }
    }

    # The pawn that owns the interaction behavior. Entity-scoped: the host drives
    # it via on_update. In a real project this is the player rig; here a bare
    # Xform is enough since the behavior gaze-picks from `ctx.camera()`.
    def Xform "Pawn" (
        prepend apiSchemas = ["IdtxBehaviorAPI"]
        doc = "Carries the pinch_select_widget behavior (scene-wide gaze-pinch panel toggle)."
    )
    {
        token idtx:behavior:kind = "runtime"
        string idtx:behavior:name = "pinch_select_widget"
        string idtx:behavior:version = "0.1.0"
        string idtx:behavior:uuid = "idtx-psw0-0000-4000-8000-000000000001"
        asset idtx:behavior:source = @./behaviors/pinch_select_widget.rs@
        uniform token[] idtx:behavior:capabilities = ["scene_query", "stage_edit"]
    }
}
