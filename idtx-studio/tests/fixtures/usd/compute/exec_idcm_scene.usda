#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Fixture for env_idcm_provider_resolves_dynamic_vars. Three chains: Compute_Environment(idcm:CURRENT_TIME) → TimeSink, Compute_Environment(idcm:CURRENT_TIME_LESS5) → TimeLess5Sink, and Compute_Environment(idcm:INTERVAL) → IntervalSink. The Rust-side default `idcm:` provider resolves each key to a value computed fresh on every compute. Three value keys."
)

def Xform "World"
{
    def Compute_Environment "Now"
    {
        string inputs:key = "idcm:CURRENT_TIME"
        string outputs:value = ""
    }

    def ComputeValueSink "TimeSink"
    {
        string string_value = ""
        string string_value.connect = </World/Now.outputs:value>
    }

    def Compute_Environment "NowLess5"
    {
        string inputs:key = "idcm:CURRENT_TIME_LESS5"
        string outputs:value = ""
    }

    def ComputeValueSink "TimeLess5Sink"
    {
        string string_value = ""
        string string_value.connect = </World/NowLess5.outputs:value>
    }

    def Compute_Environment "Interval"
    {
        string inputs:key = "idcm:INTERVAL"
        string outputs:value = ""
    }

    def ComputeValueSink "IntervalSink"
    {
        string string_value = ""
        string string_value.connect = </World/Interval.outputs:value>
    }
}
