#usda 1.0
(
    defaultPrim = "World"
    doc = "Fixture for the camera-HUD overlay tests. Provides /World/Camera; the IdtxHud child is defined into the SESSION layer at runtime by the test."
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 50
        float2 clippingRange = (0.1, 10000)
        double3 xformOp:translate = (0, 1.6, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
