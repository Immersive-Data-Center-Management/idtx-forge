#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "World" {
    def BasisCurves "Straight" {
        uniform token type = "linear"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [2, 3]
        point3f[] points = [(0,0,0), (10,0,0), (0,0,2), (3,0,2), (3,0,6)]
    }
    def BasisCurves "Bezier" {
        uniform token type = "cubic"
        uniform token basis = "bezier"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [7]
        point3f[] points = [(0,0,0), (0,0,0), (1,0,2), (2,0,2), (3,0,2), (4,0,0), (4,0,0)]
        custom double idtx:curve:toleranceMetres = 0.0001
    }
    def BasisCurves "Degenerate" {
        uniform token type = "cubic"
        uniform token basis = "bezier"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [4]
        point3f[] points = [(1,2,3), (1,2,3), (1,2,3), (1,2,3)]
    }
    def BasisCurves "Unsupported" {
        uniform token type = "cubic"
        uniform token basis = "bspline"
        int[] curveVertexCounts = [4]
        point3f[] points = [(0,0,0), (1,0,0), (2,0,1), (3,0,0)]
    }
    def NurbsCurves "Nurbs" { }
    def HermiteCurves "Hermite" { }
}
