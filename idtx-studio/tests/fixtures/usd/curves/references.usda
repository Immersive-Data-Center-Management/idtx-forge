#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Z"
)
def Xform "A" (prepend references = @route_asset.usda@) {
    double3 xformOp:scale = (2, 1, 3)
    uniform token[] xformOpOrder = ["xformOp:scale"]
}
def Xform "B" (prepend references = @route_asset.usda@) {
    double3 xformOp:translate = (100, 0, 100)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
