#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "World"
{
    def Material "Default"
    {
        token outputs:surface.connect = </World/Default/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.3, 0.4, 0.5)
            color3f inputs:emissiveColor = (0.15, 3, 1.95)
            float inputs:metallic = 1
            float inputs:roughness = 0.2
            float inputs:opacity = 0.4
            float inputs:opacityThreshold = 0
            token outputs:surface
        }
    }
    def Material "Transparent" (prepend references = </World/Default>)
    {
        over "Shader"
        {
            token inputs:opacityMode = "transparent"
        }
    }
    def Material "Presence" (prepend references = </World/Default>)
    {
        over "Shader"
        {
            token inputs:opacityMode = "presence"
        }
    }
    def Material "Interface" (prepend references = </World/Default>)
    {
        token inputs:mode = "presence"
        def NodeGraph "Graph"
        {
            token inputs:mode.connect = </World/Interface.inputs:mode>
        }
        over "Shader"
        {
            token inputs:opacityMode = "transparent"
            token inputs:opacityMode.connect = </World/Interface/Graph.inputs:mode>
        }
    }
    def Material "Invalid" (prepend references = </World/Default>)
    {
        over "Shader"
        {
            token inputs:opacityMode = "unsupported"
        }
    }
    def Material "Mask" (prepend references = </World/Presence>)
    {
        over "Shader"
        {
            float inputs:opacityThreshold = 0.5
        }
    }
    def Xform "InheritedBinding" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Default>
        def Mesh "Patch"
        {
            point3f[] points = [(-1,-1,0), (1,-1,0), (1,1,0), (-1,1,0)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0,1,2,3]
            uniform token subdivisionScheme = "none"
            bool doubleSided = false
        }
    }
    def Cube "A" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Transparent>
    }
    def Cube "B" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Presence>
    }
    def Cube "C" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Interface>
    }
    def Cube "D" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Invalid>
    }
    def Cube "E" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Mask>
    }
}
