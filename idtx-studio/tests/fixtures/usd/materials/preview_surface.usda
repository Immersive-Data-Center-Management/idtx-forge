#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
    doc = "Fixture for preview_surface_constants_and_bound_sphere_are_typed_viewport_records and inspection_reports_composed_variants_and_applied_apis. A Sphere bound to /World/Looks/Blue (UsdPreviewSurface: baseColor=(0.05,0.2,0.8), metallic=0.2, roughness=0.35). /World has MaterialBindingAPI applied."
)

def Xform "World" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </World/Looks/Blue>

    def Sphere "Ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Blue>
    }

    def Sphere "InheritedBinding"
    {
        double radius = 0.5
    }

    def Scope "Looks"
    {
        def Material "Blue"
        {
            token outputs:surface.connect = </World/Looks/Blue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.2, 0.8)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }
}
