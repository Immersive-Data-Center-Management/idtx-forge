#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

# A MaterialX standard_surface glass material authoring both the scalar
# `transmission` (folded into opacity by material_record() in usd_shim.cpp) and a
# non-white `transmission_color` (the Beer-Lambert absorption tint that colours the
# background seen through the glass). Guards that transmission_color is projected
# through to MaterialRecord.transmission_color rather than dropped.
def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Glass"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.8, 0.12, 0.04)
                float inputs:metalness = 0
                float inputs:specular_roughness = 0.1
                float inputs:transmission = 0.9
                color3f inputs:transmission_color = (0.1, 0.8, 0.2)
                token outputs:surface
            }
        }
    }

    def Mesh "GlassPlane" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Glass>
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
    }
}
