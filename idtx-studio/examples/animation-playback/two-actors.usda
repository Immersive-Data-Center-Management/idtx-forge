#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
    timeCodesPerSecond = 24
    startTimeCode = 0
    endTimeCode = 240
)
def Xform "World"
{
    def Xform "First" (prepend references = @./actor.usda@)
    {
        double3 xformOp:translate = (-2,0,0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Second" (prepend references = @./actor.usda@)
    {
        double3 xformOp:translate = (2,0,0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        custom uniform double idtx:animation:idle:speed = 0.5
    }
    def Cube "Rigid"
    {
        double size = 0.4
        double3 xformOp:translate.timeSamples = { 0: (0,0,-2), 240: (0,2,-2) }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
