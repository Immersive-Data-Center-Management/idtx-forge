class "IdtxCollisionBodyAPI" (
    customData = {
        string userDocBrief = """Marks this prim's subtree as a single IDTX collision / interaction\r
        body: a raycast hit on any descendant collider resolves up to this prim\r
        (idtx_scene::collision_body_of / Scene::collision_body), so gaze /\r
        highlight / grab act on the whole asset, not the one part that was hit.\r
        Carries no geometry — colliders live on the descendant gprims\r
        (UsdPhysicsCollisionAPI)."""
    }
)
{
}

