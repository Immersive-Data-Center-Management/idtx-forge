<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by idtx-build AndroidApkPackager. Placeholders are substituted at
     package time: {{PACKAGE}} (applicationId), {{LABEL}} (display name),
     {{LIB_NAME}} (the runtime cdylib stem, i.e. libidtx_runtime.so -> idtx_runtime). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{{PACKAGE}}"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Intentionally no uses-sdk element here: aapt2 synthesizes one from the
         assembler's min/target SDK version flags. Declaring it in this file
         would pin the versions and make those flags inert. -->

    <!-- Quest 6DoF head tracking is required for an immersive OpenXR app. -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />
    <!-- Hand tracking is optional; controllers remain the primary input. -->
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <!-- Network access. Without android.permission.INTERNET, netd denies this
         app's UID all egress AND resolution: getaddrinfo returns EAI_NODATA
         ("No address associated with hostname") for every host, so behavior
         `net` calls and remote USD fetches fail even though the host is on the
         cooked [network] allowlist and resolvable by other apps on the same
         network. ACCESS_NETWORK_STATE lets the runtime query connectivity. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="{{LABEL}}"
        android:allowBackup="false"
        android:hasCode="false"
        android:extractNativeLibs="true">

        <!-- The Meta OpenXR loader is bundled inside the APK at
             lib/arm64-v8a/libopenxr_loader.so, NOT declared as a system
             uses-native-library: Quest does not expose libopenxr_loader.so as a
             reconcilable system library, and a required uses-native-library for
             it fails install with INSTALL_FAILED_MISSING_SHARED_LIBRARY. -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|quest3|questpro" />
        <!-- Launch straight into immersive VR rather than a 2D panel window. The
             Quest shell checks this legacy flag to grant the app immersive focus;
             without it a VR-category app can open as a floating 2D window where the
             OpenXR session never gains focus and stays stuck at session state IDLE. -->
        <meta-data android:name="com.samsung.android.vr.application.mode" android:value="vr_only" />

        <activity
            android:name="android.app.NativeActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|density">
            <!-- android-activity NativeActivity dispatches to this Rust cdylib. -->
            <meta-data android:name="android.app.lib_name" android:value="{{LIB_NAME}}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- List the app in the Quest VR library rather than the 2D grid. -->
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
