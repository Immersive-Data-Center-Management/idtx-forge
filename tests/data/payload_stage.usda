#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    # Pulled in via a payload arc from an external layer. The referencing spec is
    # a sparse `over` (no local def) so ClassifyPrimProvenance reports ViaPayload
    # once the payload is loaded (the test opens the stage with LoadAll).
    over "Pay" (
        prepend payload = @./proto_layer.usda@</Proto>
    )
    {
    }
}
